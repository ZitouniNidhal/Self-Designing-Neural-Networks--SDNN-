# ==============================================================================
# Comprehensive .gitignore for Self-Designing Neural Networks (SDNN / ArchitectAI)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# C/C++ build artifacts & extensions
*.o
*.obj
*.a
*.lib

# Distribution / Packaging / Builds
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller / Executables
*.manifest
*.spec

# Unit Test, Coverage, and Benchmark Reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.pyo
.hypothesis/
.pytest_cache/
benchmark_results/

# Linters, Type Checkers & Formatters
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
dmypy.json

# Jupyter Notebook & Lab
.ipynb_checkpoints
*-checkpoint.ipynb

# Environment & Secret Variables
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# IDEs, Editors & Tooling
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
.spyderproject
.spyproject
.ropeproject

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs & Temporary Files
*.log
logs/
tmp/
temp/
scratch/
*.tmp

# Documentation Build Artifacts
/site
docs/_build/
_build/

# ML Frameworks, Model Weights & Datasets
*.pt
*.pth
*.onnx
*.tflite
*.safetensors
*.h5
*.hdf5
*.bin
*.ckpt
dataset_cache/
data_raw/
data_processed/

# SDNN Specific Output Directories
experiments/results/*
!experiments/results/.gitkeep
models/*.pt
models/*.pth
models/*.json
!models/registry.json
